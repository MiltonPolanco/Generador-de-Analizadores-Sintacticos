    I9 [label="{ Estado 9 | E &rarr; E PLUS T •\nT &rarr; T • TIMES F\nT &rarr; T • DIV F }"];
    I10 [label="{ Estado 10 | E &rarr; E MINUS T •\nT &rarr; T • TIMES F\nT &rarr; T • DIV F }"];
    I11 [label="{ Estado 11 | T &rarr; T TIMES F • }"];
    I12 [label="{ Estado 12 | T &rarr; T DIV F • }"];

    I0 -> I1 [label="INT_LIT"];
    I0 -> I2 [label="E"];
    I0 -> I3 [label="T"];
    I0 -> I4 [label="F"];
    I2 -> I5 [label="PLUS"];
    I2 -> I6 [label="MINUS"];
    I3 -> I7 [label="TIMES"];
    I3 -> I8 [label="DIV"];
    I5 -> I1 [label="INT_LIT"];
    I5 -> I9 [label="T"];
    I5 -> I4 [label="F"];
    I6 -> I1 [label="INT_LIT"];
    I6 -> I10 [label="T"];
    I6 -> I4 [label="F"];
    I7 -> I1 [label="INT_LIT"];
