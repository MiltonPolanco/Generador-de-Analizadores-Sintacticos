    I2 [label="{ Estado 2 | E' &rarr; E •\nE &rarr; E • PLUS T\nE &rarr; E • MINUS T }"];
    I3 [label="{ Estado 3 | E &rarr; T •\nT &rarr; T • TIMES F\nT &rarr; T • DIV F }"];
