digraph "Automata SLR YAPar" {
    rankdir=LR;
    node [shape=record, fontname="Courier New", fontsize=10];

    I0 [label="{ Estado 0 | E' &rarr; • E\nE &rarr; • E PLUS T\nE &rarr; • E MINUS T\nE &rarr; • T\nT &rarr; • T TIMES F\nT &rarr; • T DIV F\nT &rarr; • F\nF &rarr; • INT_LIT }"];
