    I8 -> I1 [label="INT_LIT"];
    I8 -> I12 [label="F"];
    I9 -> I7 [label="TIMES"];
    I9 -> I8 [label="DIV"];
    I10 -> I7 [label="TIMES"];
    I10 -> I8 [label="DIV"];
}
